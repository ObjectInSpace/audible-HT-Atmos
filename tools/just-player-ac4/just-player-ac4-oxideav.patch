@@ -0,0 +1,108 @@
+package com.brouken.player.ac4;
+
+import androidx.annotation.Nullable;
+import androidx.media3.common.util.UnstableApi;
+import androidx.media3.common.util.Util;
+import androidx.media3.decoder.DecoderInputBuffer;
+import androidx.media3.decoder.SimpleDecoder;
+import androidx.media3.decoder.SimpleDecoderOutputBuffer;
+import java.nio.ByteBuffer;
+
+/** Media3 SimpleDecoder wrapper around the OxideAV AC-4 decoder. */
+@UnstableApi
+public final class Ac4Decoder
+        extends SimpleDecoder<DecoderInputBuffer, SimpleDecoderOutputBuffer, Ac4DecoderException> {
+    private static final int DEFAULT_INPUT_BUFFER_SIZE = 8192;
+
+    static {
+        System.loadLibrary("ac4oxide");
+    }
+
+    private long nativeContext;
+    private volatile int channelCount = 2;
+    private volatile int sampleRate = 48000;
+
+    public Ac4Decoder(int numInputBuffers, int numOutputBuffers) throws Ac4DecoderException {
+        super(new DecoderInputBuffer[numInputBuffers], new SimpleDecoderOutputBuffer[numOutputBuffers]);
+        nativeContext = nativeCreate();
+        if (nativeContext == 0) {
+            throw new Ac4DecoderException("Could not create OxideAV AC-4 decoder");
+        }
+        setInitialInputBufferSize(DEFAULT_INPUT_BUFFER_SIZE);
+    }
+
+    @Override
+    public String getName() {
+        return "OxideAV AC-4";
+    }
+
+    @Override
+    protected DecoderInputBuffer createInputBuffer() {
+        return new DecoderInputBuffer(DecoderInputBuffer.BUFFER_REPLACEMENT_MODE_NORMAL);
+    }
+
+    @Override
+    protected SimpleDecoderOutputBuffer createOutputBuffer() {
+        return new SimpleDecoderOutputBuffer(this::releaseOutputBuffer);
+    }
+
+    @Override
+    protected Ac4DecoderException createUnexpectedDecodeException(Throwable error) {
+        return new Ac4DecoderException("Unexpected AC-4 decode error", error);
+    }
+
+    @Override
+    @Nullable
+    protected Ac4DecoderException decode(
+            DecoderInputBuffer inputBuffer,
+            SimpleDecoderOutputBuffer outputBuffer,
+            boolean reset) {
+        try {
+            if (reset) {
+                nativeReset(nativeContext);
+            }
+
+            ByteBuffer inputData = Util.castNonNull(inputBuffer.data).duplicate();
+            byte[] compressed = new byte[inputData.remaining()];
+            inputData.get(compressed);
+
+            byte[] pcm = nativeDecode(nativeContext, compressed);
+            if (pcm == null || pcm.length == 0) {
+                outputBuffer.shouldBeSkipped = true;
+                return null;
+            }
+
+            channelCount = nativeGetChannelCount(nativeContext);
+            sampleRate = nativeGetSampleRate(nativeContext);
+            if (channelCount <= 0 || sampleRate <= 0) {
+                return new Ac4DecoderException("Decoder returned invalid output format");
+            }
+
+            ByteBuffer outputData = outputBuffer.init(inputBuffer.timeUs, pcm.length);
+            outputData.put(pcm);
+            outputData.flip();
+            return null;
+        } catch (RuntimeException e) {
+            return new Ac4DecoderException("AC-4 decode failed", e);
+        }
+    }
+
+    public int getChannelCount() { return channelCount; }
+    public int getSampleRate() { return sampleRate; }
+
+    @Override
+    public void release() {
+        super.release();
+        if (nativeContext != 0) {
+            nativeRelease(nativeContext);
+            nativeContext = 0;
+        }
+    }
+
+    private static native long nativeCreate();
+    private static native byte[] nativeDecode(long context, byte[] compressed);
+    private static native int nativeGetChannelCount(long context);
+    private static native int nativeGetSampleRate(long context);
+    private static native void nativeReset(long context);
+    private static native void nativeRelease(long context);
+}
